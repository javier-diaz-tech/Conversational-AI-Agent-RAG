@page "/"
@model ApiAgenteConversacional.AgenteConversacional.Pages.Chat.IndexModel
@{
    var model = Model;   
}
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" />
</head>
<body>
 <div class="container">
        <h1>Chat con el Agente Conversacional</h1>
        <div id="chat-container" class="chat-container">
            <div id="chat-messages" class="row card shadow-lg m-4 border border-dark border-2 rounded-4 overflow-hidden"
                 style="width: 560px; height: 300px; z-index: 1051;">          

               <div class="card-body overflow-auto bg-light d-flex flex-column gap-3 p-3" style="background-color:gray" id="chat-body">
                        
                    @foreach (var respuesta in Model.RespuestaAgente)
                    {
                                    @if(respuesta.Rol.Equals("Usuario")){
                                    <div class="text-white p-3 rounded-4 shadow-sm align-self-end" style="max-width: 85%; background-color: #2563eb;">
                                        <strong>@respuesta.Rol</strong>
                                        @string.Join("<br/>", respuesta.Contenido)
                                    </div>                                   
                                    }else
                                    {
                                    <div class="bg-white p-3 rounded-4 shadow-sm align-self-start" style="max-width: 85%;">
                                     <small class="text-primary fw-bold d-block mb-1">
                                        @respuesta.Rol</small>
                                        <p class="mb-0 small text-dark">@string.Join("<br/>", respuesta.Contenido)</p></div>
                                    }
                        
                    }
                </div>
            </div>
            <form id="chat-form" class="chat-form" method="post">
                @Html.AntiForgeryToken()                
                <div class="card-footer bg-white border-top p-2 bottom-0 row">
                    <div class="col-6">
                        <input type="text" multiline="true" name="MensajeUsuario" id="user-input" class="form-control border-0 bg-light rounded-pill px-3 me-6" placeholder="Escribe tu mensaje..." />
                    </div>
                    <div class="col-6">
                        <input type="submit" id="send-button" class="btn btn-primary align-items-center justify-content-center" style="width: 75px; height: 38px; background-color: #2563eb;" value="Enviar" />
                    </div>
                    <div id="loading-rag"
                         class="alert alert-info mt-2"
                         style="display:none;">
    
                        <div class="spinner-border spinner-border-sm me-2"
                             role="status">
                        </div>

                        Procesando documento y generando embeddings...
                    </div>
                    <div class="col-12 mt-2">
                        <label>Seleccione la casilla para habilitar RAG en base a documentos</label>
                        <input type="checkbox" name="UsarRAG" id="user-checkbox" class="form-check-input border-1 px-3 me-6" value="true" />                        
                    </div>
                    <div class="col-12 mt-2">
                        <input type="button" name="guardar-documento" id="guardar-documento" value="Subir Documento para RAG" class="btn btn-primary" onclick="Subir()" />
                    </div>
                </div>              
            </form>   
            <div class="row" id="documentos-rag">
                    @foreach (var documento in Model.DocumentosRag)
                    {
                        <div class="col-12">
                            <label>Documento Actual: @documento?.NombreArchivo</label>
                        </div>
                        <div class="col-12">
                            <label>Fragmentos: @documento?.Fragmentos </label>
                        </div>
                    }
            </div>
        </div>
 </div>   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script type="text/javascript">
        function Subir() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var input = document.createElement('input');
            input.type = 'file';
            input.accept = '.pdf,.docx'; // Puedes ajustar los tipos de archivo permitidos según tus necesidades
            input.onchange = async (event) => {
                var file = event.target.files[0];
                if (file) {
                    var formData = new FormData();
                    formData.append('archivo', file);
                    try {
                        document.getElementById("loading-rag").style.display = "block";
                        const response = await fetch('/?handler=SubirArchivo', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });
                        if (response.ok) {
                            alert('Documento subido y procesado correctamente.');
                            await cargarDocumentos();
                        } else {
                            alert('Error al subir el documento.');
                        }
                    } catch (error) {
                        console.error('Error al subir el documento:', error);
                        alert('Error al subir el documento.');
                    }
                    finally {
                        document.getElementById("loading-rag").style.display = "none";
                    }
                }
            };
            input.click();
        }


        async function cargarDocumentos() {

            const response =
                await fetch('/?handler=Documentos');

            const documentos =
                await response.json();

            const listado =
                document.getElementById("documentos-rag");

            listado.innerHTML = "";
            console.log(documentos);
            documentos.forEach(doc => {

                listado.innerHTML += `
                              <div class="col-12">
                                    <label>Documento Actual: ${doc.nombreArchivo}</label>
                                </div>
                                <div class="col-12">
                                    <label>Fragmentos: ${doc.fragmentos} </label>
                                </div>`;
            });
        }

        function scrollToBottom() {

            var chat =
                document.getElementById("chat-body");

            if (chat) {
                chat.scrollTop = chat.scrollHeight;
            }
        }

        window.onload = function () {
            scrollToBottom();
        };
    </script>
 </body>
         